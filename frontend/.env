# Frontend environment variables (Expo reads EXPO_PUBLIC_* automatically)
# Restart `expo start` after changing these so Metro picks them up.

EXPO_PUBLIC_API_URL=http://172.20.10.4:8080

# WebSocket chat is proxied through the API gateway on the SAME host:port as
# the REST API (172.20.10.4:8080). This is the only WS URL the app needs.
EXPO_PUBLIC_WS_URL=ws://172.20.10.4:8080/ws
